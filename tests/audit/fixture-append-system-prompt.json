{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "claude-bin-fresh",
          "cmd": "claude",
          "args": [
            {
              "validator": "^--print$"
            },
            {
              "validator": "^--permission-mode$"
            },
            {
              "validator": "^bypassPermissions$"
            },
            {
              "validator": "^--output-format$"
            },
            {
              "validator": "^stream-json$"
            },
            {
              "validator": "^--include-partial-messages$"
            },
            {
              "validator": "^--verbose$"
            },
            {
              "validator": "^--max-turns$"
            },
            {
              "validator": "^30$"
            },
            {
              "validator": "^--add-dir$"
            },
            {
              "validator": "^/Users/[A-Za-z0-9_.\\-]+/\\.mneme/scratch$"
            },
            {
              "validator": "^--exclude-dynamic-system-prompt-sections$"
            },
            {
              "validator": "^--append-system-prompt$"
            },
            {
              "validator": "^Output rendering context: the client renders Markdown with KaTeX math \\(display via \\$\\$\\.\\.\\.\\$\\$, inline via \\$\\.\\.\\.\\$\\)\\. Use pure LaTeX only — do NOT add ASCII-fallback lines after math blocks\\. Use # / ## / ### for section hierarchy\\. Use --- \\(hr\\) between major sections\\.$"
            },
            {
              "validator": ".+"
            }
          ]
        },
        {
          "name": "claude-bin-resume",
          "cmd": "claude",
          "args": [
            {
              "validator": "^--print$"
            },
            {
              "validator": "^--resume$"
            },
            {
              "validator": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            {
              "validator": "^--permission-mode$"
            },
            {
              "validator": "^bypassPermissions$"
            },
            {
              "validator": "^--output-format$"
            },
            {
              "validator": "^stream-json$"
            },
