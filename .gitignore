.env
.env.*
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Logs
*.log
npm-debug.log*

# Husky
.husky/_

# Claude Code
CLAUDE.md
*_CN.md

# Claude Code per-user local overrides
.claude/settings.local.json

# Handoff artifacts — bulky screenshot uploads from user prototype iteration sessions
# (the prototype HTML itself IS committed; only the source screenshots are excluded)
.planning/handoff/*/mneme/project/uploads/

# Visual Review HTML — ephemeral per design D-UP-06 (R8 of dev-feedback-loop spec).
# Each /gsd-verify-work <N> run produces a fresh .planning/handoff/<date>-phase-<N>-verify.html;
# never amended; not part of project record. Pattern extended 2026-05-15 to cover
# all *.html under handoff/ — change-review / gsd-update preview / dogfood HTMLs
# all share the "ephemeral artifact for live human review, then discard" lifecycle.
.planning/handoff/*.html

# Dev feedback loop (Phase 01.1) — ephemeral signals, never committed.
# Tracked exemptions: .gitkeep + README.md.
# NOTE: pattern is `.dev-logs/*` (contents), not `.dev-logs/` (the directory
# itself). git docs: "It is not possible to re-include a file if a parent
# directory of that file is excluded." Using the contents-glob lets the `!`
# negations actually surface .gitkeep + README.md as tracked.
.dev-logs/*
!.dev-logs/.gitkeep
!.dev-logs/README.md

# Same lifecycle for src-tauri/.dev-logs/ — cargo tauri dev artifacts (build
# output captured during /gsd-verify-work + manual dogfood sessions).
src-tauri/.dev-logs/

# Graphify working directory — SHA256 cache + raw output, rebuildable.
# Persistent artifacts live in .planning/graphs/ (committed).
graphify-out/
